# RocheKAP production environment.
# Copy to .env.production and replace every CHANGE_ME value.
# Never commit .env.production.

COMPOSE_PROJECT_NAME=rochekap-production

# Immutable application images produced by CI. Tags must never be "latest".
APP_IMAGE=CHANGE_ME_REGISTRY/rd-china/knowledge-agent-platform-app:1.0.0
FRONTEND_IMAGE=CHANGE_ME_REGISTRY/rd-china/knowledge-agent-platform-ui:1.0.0
DOCREADER_IMAGE=CHANGE_ME_REGISTRY/rd-china/knowledge-agent-platform-docreader:1.0.0
AUTH_SERVICE_IMAGE=CHANGE_ME_REGISTRY/rd-china/knowledge-agent-platform-auth-service:1.0.0
API_GATEWAY_IMAGE=CHANGE_ME_REGISTRY/rd-china/knowledge-agent-platform-api-gateway:1.0.0

GATEWAY_INTERNAL_BIND=CHANGE_ME_INTERNAL_BIND_ADDRESS
GATEWAY_INTERNAL_PORT=8088
GATEWAY_EXTERNAL_BIND=0.0.0.0
GATEWAY_EXTERNAL_PORT=80
AUTH_INTERNAL_ALLOWED_ORIGINS=https://CHANGE_ME_INTERNAL_HOST
AUTH_EXTERNAL_ALLOWED_ORIGINS=https://CHANGE_ME_EXTERNAL_HOST
AUTH_INTERNAL_ALLOWED_REDIRECT_URIS=https://CHANGE_ME_INTERNAL_HOST/
AUTH_EXTERNAL_ALLOWED_REDIRECT_URIS=https://CHANGE_ME_EXTERNAL_HOST/
TZ=Asia/Shanghai
ROCHE_KAP_LANGUAGE=zh-CN
GIN_MODE=release

# Production secrets. Prefer injecting them from the deployment secret manager.
JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
SYSTEM_AES_KEY=CHANGE_ME_EXACTLY_32_ASCII_BYTES
AUTH_INTERNAL_SERVICE_SECRET=CHANGE_ME_RANDOM_INTERNAL_GATEWAY_TO_AUTH_SECRET_AT_LEAST_48_CHARS
AUTH_EXTERNAL_SERVICE_SECRET=CHANGE_ME_RANDOM_EXTERNAL_GATEWAY_TO_AUTH_SECRET_AT_LEAST_48_CHARS
AUTH_REFRESH_COOKIE_SECURE=true

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_NAME=RocheKAP

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_PREFIX=rochekap:

# Bundled MinIO can be replaced by an approved enterprise S3-compatible service.
STORAGE_TYPE=minio
LOCAL_STORAGE_BASE_DIR=/data/files
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY_ID=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_NAME=rochekap
AUTO_RECOVER_DIRTY=true
MAX_FILE_SIZE_MB=50

RETRIEVE_DRIVER=milvus
MILVUS_ADDRESS=milvus:19530
MILVUS_COLLECTION=roche_kap_embeddings
MILVUS_METRIC_TYPE=IP

NEO4J_ENABLE=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD

DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc

# Production authentication is SAML-only. Local credentials remain available
# only in the local/server-development environment.
AUTH_PASSWORD_LOGIN_ENABLE=false
AUTH_REGISTRATION_ENABLE=false
AUTH_REGISTRATION_DEFAULT_ROLE=viewer
AUTH_REGISTRATION_DEV_ROLE_SELECTION=false

# PingIdentity SAML 2.0 configuration. PingIdentity must register both SP
# entity IDs and their corresponding ACS URLs.
OIDC_AUTH_ENABLE=false
SAML_AUTH_ENABLE=true
SAML_AUTH_PROVIDER_DISPLAY_NAME="Roche PingIdentity SSO"
SAML_AUTH_IDP_METADATA_URL=https://CHANGE_ME_PING_HOST/CHANGE_ME_IDP_METADATA_PATH
SAML_AUTH_AUTO_PROVISION=true
SAML_AUTH_SIGN_REQUEST=true
SAML_AUTH_ALLOW_IDP_INITIATED=false
SAML_AUTH_ALLOW_EPHEMERAL_CERT=false
SAML_INTERNAL_SP_ENTITY_ID=CHANGE_ME_INTERNAL_SP_ENTITY_ID
SAML_INTERNAL_ACS_URL=https://CHANGE_ME_INTERNAL_HOST/api/v1/auth/saml/acs
SAML_EXTERNAL_SP_ENTITY_ID=CHANGE_ME_EXTERNAL_SP_ENTITY_ID
SAML_EXTERNAL_ACS_URL=https://CHANGE_ME_EXTERNAL_HOST/api/v1/auth/saml/acs
SAML_INTERNAL_SP_CERT_HOST_PATH=/CHANGE_ME_ABSOLUTE_HOST_PATH/internal-saml-sp.crt
SAML_INTERNAL_SP_KEY_HOST_PATH=/CHANGE_ME_ABSOLUTE_HOST_PATH/internal-saml-sp.key
SAML_EXTERNAL_SP_CERT_HOST_PATH=/CHANGE_ME_ABSOLUTE_HOST_PATH/external-saml-sp.crt
SAML_EXTERNAL_SP_KEY_HOST_PATH=/CHANGE_ME_ABSOLUTE_HOST_PATH/external-saml-sp.key
SAML_USER_INFO_MAPPING_SUBJECT=CHANGE_ME_PING_STABLE_SUBJECT_ATTRIBUTE
SAML_USER_INFO_MAPPING_USER_NAME=CHANGE_ME_PING_USERNAME_ATTRIBUTE
SAML_USER_INFO_MAPPING_EMAIL=CHANGE_ME_PING_EMAIL_ATTRIBUTE

# Real Workday/MuleSoft HTTP adapter.
WORKDAY_ENABLE=true
WORKDAY_PROVIDER=http
WORKDAY_CONNECTION_KEY=roche-production
WORKDAY_BASE_URL=https://CHANGE_ME_WORKDAY_GATEWAY/workday/v1
WORKDAY_ORG_UNITS_PATH=/org-units
WORKDAY_WORKERS_PATH=/workers
WORKDAY_TOKEN_URL=https://CHANGE_ME_WORKDAY_TOKEN_ENDPOINT
WORKDAY_CLIENT_ID=CHANGE_ME_WORKDAY_CLIENT_ID
WORKDAY_CLIENT_SECRET=CHANGE_ME_WORKDAY_CLIENT_SECRET
WORKDAY_SCOPE=workday.read
WORKDAY_PAGE_SIZE=200
WORKDAY_REQUEST_TIMEOUT=30s

# Self-hosted Langfuse. Replace all secrets and project keys.
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=CHANGE_ME_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=CHANGE_ME_LANGFUSE_SECRET_KEY
LANGFUSE_SALT=CHANGE_ME_LANGFUSE_SALT
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
LANGFUSE_NEXTAUTH_URL=https://CHANGE_ME_LANGFUSE_PUBLIC_URL
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_LANGFUSE_NEXTAUTH_SECRET
LANGFUSE_CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
LANGFUSE_MINIO_USER=CHANGE_ME_LANGFUSE_MINIO_USER
LANGFUSE_MINIO_PASSWORD=CHANGE_ME_LANGFUSE_MINIO_PASSWORD

# Allow only exact enterprise integration hosts.
SSRF_WHITELIST=CHANGE_ME_PING_HOST,CHANGE_ME_WORKDAY_HOST

# Optional external URL for generated links.
APP_EXTERNAL_URL=https://CHANGE_ME_APPLICATION_HOST
