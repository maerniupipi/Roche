# ============================================================
# Frontend Builder Base 镜像（本地一次性构建，推送到内部 Registry）
# 预装所有 npm 依赖，CI 只需要 COPY 源码 + npm run build
# ============================================================
FROM node:22-alpine

WORKDIR /app
COPY frontend/package.json ./

ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN npm config set registry ${NPM_REGISTRY} && \
    npm install --no-package-lock

# 依赖已缓存在镜像层中，CI 只需 COPY 源码 + npm run build
