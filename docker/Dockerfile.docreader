# ============================================================
# Stage 1: DocReader Base（原 docreader-base，无需外部 Registry）
# ============================================================
FROM python:3.10.18-bookworm AS base

# 替换为阿里云镜像
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources

WORKDIR /app

# 安装构建依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        python3-dev \
        libjpeg-dev \
        zlib1g-dev \
        libffi-dev \
        libgl1 \
        libglib2.0-0 \
        wget \
        antiword \
        curl \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# 安装运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
        libjpeg62-turbo \
        wget \
        gnupg \
        openjdk-17-jre-headless \
        libgl1 \
        libglib2.0-0 \
        antiword \
        tar \
        dpkg \
        libxinerama1 \
        libfontconfig1 \
        libdbus-glib-1-2 \
        libcairo2 \
        libcups2 \
        libglu1-mesa \
        libsm6 \
        libreoffice \
        curl \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv 和 Playwright（阿里云镜像优先，失败回退官方源）
RUN (pip install --index-url https://mirrors.aliyun.com/pypi/simple/ uv==0.11.22 playwright --break-system-packages || \
     pip install uv==0.11.22 playwright --break-system-packages)

# 安装 Playwright 浏览器
RUN python -m playwright install webkit && \
    python -m playwright install-deps webkit

RUN mkdir -p /tmp/docreader

# ============================================================
# Stage 2: 构建阶段
# ============================================================
FROM base AS builder

WORKDIR /app

COPY docreader/pyproject.toml docreader/uv.lock ./
ARG PYPI_INDEX_URL=""
RUN if [ -n "$PYPI_INDEX_URL" ]; then \
        (pip install --index-url "$PYPI_INDEX_URL" uv==0.11.22 --break-system-packages || \
         pip install uv==0.11.22 --break-system-packages) && \
        UV_INDEX_URL="$PYPI_INDEX_URL" python -m uv sync --no-dev; \
    else \
        (pip install --index-url https://mirrors.aliyun.com/pypi/simple/ uv==0.11.22 --break-system-packages || \
         pip install uv==0.11.22 --break-system-packages) && \
        UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ python -m uv sync --no-dev; \
    fi

COPY docreader docreader

ENV PATH="/app/.venv/bin:${PATH}"
RUN chmod +x docreader/scripts/generate_proto.sh && \
    bash docreader/scripts/generate_proto.sh

# ============================================================
# Stage 3: 运行阶段
# ============================================================
FROM base AS runner

WORKDIR /app

ENV VIRTUAL_ENV=/app/.venv
COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

COPY --from=builder /usr/local/bin /usr/local/bin

COPY docreader/pyproject.toml docreader/uv.lock ./
COPY --from=builder /app/docreader docreader

EXPOSE 50051

CMD ["uv", "run", "-m", "docreader.main"]
