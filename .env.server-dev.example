# RocheKAP Linux server source-development environment.
# Copy this file to <project-root>/.env.server-dev.
# It contains development credentials and must not be exposed to the public internet.

# Replace this value with the browser-reachable server URL. Do not add a
# trailing slash. It is used to generate gateway and Mock SAML URLs.
SERVER_DEV_PUBLIC_URL=http://SERVER_IP_OR_HOST
COMPOSE_PROJECT_NAME=rochekap-server-dev

# Development service ports.
APP_PORT=8080
FRONTEND_PORT=80
MOCK_SAML_PORT=8091
DOCREADER_BIND=0.0.0.0
DOCREADER_PORT=50051
GATEWAY_INTERNAL_BIND=127.0.0.1
GATEWAY_INTERNAL_PORT=8088
GATEWAY_EXTERNAL_BIND=0.0.0.0
GATEWAY_EXTERNAL_PORT=8089
# server_dev.sh derives the four values below from SERVER_DEV_PUBLIC_URL and
# the gateway ports. Set an exact value only when a reverse proxy changes the
# browser-facing origin.
AUTH_INTERNAL_ALLOWED_ORIGINS=
AUTH_EXTERNAL_ALLOWED_ORIGINS=
AUTH_INTERNAL_ALLOWED_REDIRECT_URIS=
AUTH_EXTERNAL_ALLOWED_REDIRECT_URIS=
TZ=Asia/Shanghai
ROCHE_KAP_LANGUAGE=zh-CN
GIN_MODE=debug

# Mainland China dependency mirrors used by the source-image builds. These
# affect apt, PyPI/uv, npm, Go modules, and Playwright browser downloads.
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
GOPROXY=https://goproxy.cn,direct
PLAYWRIGHT_DOWNLOAD_HOST=https://npmmirror.com/mirrors/playwright
# Optional enterprise-registry overrides for Dockerfile base images:
# GO_BASE_IMAGE=registry.example.com/library/golang:1.26.0-bookworm
# NODE_BASE_IMAGE=registry.example.com/library/node:24.4.1-bookworm-slim
# PYTHON_BASE_IMAGE=registry.example.com/library/python:3.10.18-bookworm

# Fixed development-only application secrets.
# SYSTEM_AES_KEY is exactly 32 ASCII bytes, as required by AES-256.
JWT_SECRET=rochekap-dev-server-jwt-secret
SYSTEM_AES_KEY=rochekap-dev-system-key-32bytes!
AUTH_INTERNAL_SERVICE_SECRET=rochekap-server-dev-internal-gateway-auth-secret-change-me
AUTH_EXTERNAL_SERVICE_SECRET=rochekap-server-dev-external-gateway-auth-secret-change-me
AUTH_REFRESH_COOKIE_SECURE=false

# Core Compose services. These use Docker Compose service names, not localhost.
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123!@#
DB_NAME=RocheKAP

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=redis123!@#
REDIS_DB=0
REDIS_PREFIX=rochekap:

STORAGE_TYPE=minio
LOCAL_STORAGE_BASE_DIR=/data/files
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_BUCKET_NAME=rochekap
AUTO_RECOVER_DIRTY=true
MAX_FILE_SIZE_MB=50

# Knowledge retrieval. The server script starts the Milvus profile by default.
RETRIEVE_DRIVER=milvus
MILVUS_ADDRESS=milvus:19530
MILVUS_COLLECTION=roche_kap_embeddings
MILVUS_METRIC_TYPE=IP

# Knowledge graph. The server script starts the Neo4j profile by default.
NEO4J_ENABLE=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Internal document parser address.
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc

# Email/password development registration.
AUTH_PASSWORD_LOGIN_ENABLE=true
AUTH_REGISTRATION_ENABLE=true
AUTH_REGISTRATION_DEFAULT_ROLE=viewer
AUTH_REGISTRATION_DEV_ROLE_SELECTION=true

# Development uses the bundled Mock SAML IdP. No customer PingIdentity
# metadata or certificate is required; server_dev.sh derives all URLs.
# Server development authentication uses Mock SAML exclusively.
OIDC_AUTH_ENABLE=false
SAML_AUTH_ENABLE=true
SAML_AUTH_PROVIDER_DISPLAY_NAME="Mock SAML"
SAML_AUTH_IDP_METADATA_URL=
SAML_AUTH_AUTO_PROVISION=true
SAML_AUTH_DEV_SYSTEM_ADMIN_EMAILS=developer001@rochekap.local,developer002@rochekap.local,developer003@rochekap.local,developer004@rochekap.local,developer005@rochekap.local,developer006@rochekap.local,developer007@rochekap.local,developer008@rochekap.local,developer009@rochekap.local,developer010@rochekap.local
SAML_AUTH_SIGN_REQUEST=false
SAML_AUTH_ALLOW_IDP_INITIATED=false
SAML_INTERNAL_SP_ENTITY_ID=urn:rochekap:internal:sp
SAML_INTERNAL_ACS_URL=
SAML_EXTERNAL_SP_ENTITY_ID=urn:rochekap:external:sp
SAML_EXTERNAL_ACS_URL=
# Development may explicitly use ephemeral certificates. For stable local
# metadata, configure a separate certificate/key path for each trust zone.
SAML_AUTH_ALLOW_EPHEMERAL_CERT=true
SAML_INTERNAL_SP_CERT_FILE=
SAML_INTERNAL_SP_KEY_FILE=
SAML_EXTERNAL_SP_CERT_FILE=
SAML_EXTERNAL_SP_KEY_FILE=
SAML_USER_INFO_MAPPING_SUBJECT=subject
SAML_USER_INFO_MAPPING_USER_NAME=username
SAML_USER_INFO_MAPPING_EMAIL=email
MOCK_SAML_USERNAME=admin
MOCK_SAML_PASSWORD=Admin123!
MOCK_SAML_EMAIL=admin@rochekap.local
MOCK_SAML_DEVELOPER_COUNT=100
MOCK_SAML_DEVELOPER_PASSWORD=Dev12345!
MOCK_SAML_DEVELOPER_EMAIL_DOMAIN=rochekap.local

# Workday/MuleSoft adapter. Credentials remain environment secrets and are not
# stored in PostgreSQL. The adapter contract is documented in
# docs/enterprise-integrations.md.
WORKDAY_ENABLE=true
WORKDAY_PROVIDER=mock
WORKDAY_CONNECTION_KEY=server-dev-mock
WORKDAY_MOCK_FILE=config/mock/workday.json
WORKDAY_PAGE_SIZE=200
WORKDAY_REQUEST_TIMEOUT=30s


# Optional external URL. Set this when IM integrations must access uploaded files.
# APP_EXTERNAL_URL=https://rochekap.example.com

# Self-hosted Langfuse containers start by default. Application tracing remains
# disabled until valid project keys are configured below.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_SALT=rochekap-dev-langfuse-salt
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# server_dev.sh derives the browser-facing URL from SERVER_DEV_PUBLIC_URL.
LANGFUSE_NEXTAUTH_SECRET=rochekap-dev-langfuse-nextauth-secret

# Optional outbound network controls.
# WEB_PROXY=http://proxy.example.internal:8080
# If an enterprise integration is on an internal host, allow only that exact host.
# SSRF_WHITELIST=idp.example.internal

