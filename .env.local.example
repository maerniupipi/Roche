# Local source-development environment.
# Copy to .env.local. Never expose these development credentials publicly.

COMPOSE_PROJECT_NAME=rochekap-local
TZ=Asia/Shanghai
GIN_MODE=release
DEV_BACKEND_URL=http://127.0.0.1:8080
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8088
# When proxying to a non-loopback server, Vite automatically rewrites Origin
# to the proxy target so remote CORS checks accept POST/PUT/DELETE. Set an exact
# browser-facing origin only when a reverse proxy makes it differ from target.
# VITE_DEV_PROXY_ORIGIN=http://10.3.97.217:8089
# VITE_DEV_PROXY_REWRITE_ORIGIN=false
APP_PORT=8080
AUTH_SERVICE_PORT=8081
GATEWAY_PORT=8088
MOCK_SAML_PORT=8091
AUTH_SERVICE_INTERNAL_SECRET=rochekap-local-gateway-auth-secret-32bytes
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5176,http://localhost:5176
AUTH_ALLOWED_REDIRECT_URIS=http://127.0.0.1:5173/,http://localhost:5173/,http://127.0.0.1:5174/default/,http://localhost:5174/default/,http://127.0.0.1:5175/admin/,http://localhost:5175/admin/,http://127.0.0.1:5176/app/,http://localhost:5176/app/
AUTH_PASSWORD_LOGIN_ENABLE=true

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123!@#
DB_NAME=RocheKAP

JWT_SECRET=rochekap-local-jwt-secret
SYSTEM_AES_KEY=rochekap-local-system-key-32byte

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=redis123!@#
REDIS_DB=0
REDIS_PREFIX=rochekap:

STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
RETRIEVE_DRIVER=milvus
MILVUS_ADDRESS=milvus:19530
MILVUS_COLLECTION=roche_kap_embeddings
MILVUS_METRIC_TYPE=IP

NEO4J_ENABLE=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc

AUTH_REGISTRATION_ENABLE=true
AUTH_REGISTRATION_DEFAULT_ROLE=viewer
AUTH_REGISTRATION_DEV_ROLE_SELECTION=true
# Development authentication uses Mock SAML exclusively.
OIDC_AUTH_ENABLE=false
SAML_AUTH_ENABLE=true
SAML_AUTH_PROVIDER_DISPLAY_NAME="Mock SAML"
SAML_AUTH_IDP_METADATA_URL=http://127.0.0.1:8091/metadata
SAML_AUTH_AUTO_PROVISION=true
SAML_AUTH_DEV_SYSTEM_ADMIN_EMAILS=developer001@rochekap.local,developer002@rochekap.local,developer003@rochekap.local,developer004@rochekap.local,developer005@rochekap.local,developer006@rochekap.local,developer007@rochekap.local,developer008@rochekap.local,developer009@rochekap.local,developer010@rochekap.local
SAML_AUTH_SIGN_REQUEST=false
SAML_AUTH_ALLOW_IDP_INITIATED=false
SAML_AUTH_SP_ENTITY_ID=urn:rochekap:local:sp
SAML_AUTH_ACS_URL=http://127.0.0.1:8088/api/v1/auth/saml/acs
SAML_AUTH_ALLOW_EPHEMERAL_CERT=true
SAML_USER_INFO_MAPPING_SUBJECT=subject
SAML_USER_INFO_MAPPING_USER_NAME=username
SAML_USER_INFO_MAPPING_EMAIL=email
MOCK_SAML_PUBLIC_URL=http://127.0.0.1:8091
MOCK_SAML_USERNAME=admin
MOCK_SAML_PASSWORD=Admin123!
MOCK_SAML_EMAIL=admin@rochekap.local
MOCK_SAML_DEVELOPER_COUNT=100
MOCK_SAML_DEVELOPER_PASSWORD=Dev12345!
MOCK_SAML_DEVELOPER_EMAIL_DOMAIN=rochekap.local
# The Auth Service fetches Mock SAML metadata from loopback in host mode.
SSRF_WHITELIST_EXTRA=127.0.0.1,localhost

# Phase 3 enterprise directory development adapter. Enable this to test the
# complete Workday projection and organization-membership flow without access
# to Roche infrastructure.
WORKDAY_ENABLE=true
WORKDAY_PROVIDER=mock
WORKDAY_CONNECTION_KEY=local-mock
WORKDAY_MOCK_FILE=config/mock/workday.json
WORKDAY_PAGE_SIZE=200
WORKDAY_REQUEST_TIMEOUT=30s

# Local Langfuse is started by dev-all.sh.
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=lf_pk_00000000000000000000000000000000
LANGFUSE_SECRET_KEY=lf_sk_000000000000000000000000000000000000000000000000
LANGFUSE_RELEASE=local-dev
LANGFUSE_ENVIRONMENT=development
LANGFUSE_DEBUG=false
LANGFUSE_CLICKHOUSE_PASSWORD=rochekap-clickhouse-local
LANGFUSE_MINIO_PASSWORD=rochekap-minio-local
LANGFUSE_SALT=rochekap-local-langfuse-salt
LANGFUSE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANGFUSE_NEXTAUTH_SECRET=rochekap-local-nextauth-secret
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_TELEMETRY_ENABLED=false
LANGFUSE_INIT_ORG_ID=rochekap-local
LANGFUSE_INIT_ORG_NAME=RocheKAP-Local
LANGFUSE_INIT_PROJECT_ID=rochekap-local
LANGFUSE_INIT_PROJECT_NAME=RocheKAP-Local
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=lf_pk_00000000000000000000000000000000
LANGFUSE_INIT_PROJECT_SECRET_KEY=lf_sk_000000000000000000000000000000000000000000000000
LANGFUSE_INIT_USER_EMAIL=admin@rochekap.local
LANGFUSE_INIT_USER_NAME=RocheKAP-Admin
LANGFUSE_INIT_USER_PASSWORD=LangfuseLocal2026!
