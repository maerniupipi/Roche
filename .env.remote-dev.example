# Local source code connected directly to the shared server-development
# infrastructure. Copy to .env.remote-dev; the copied file is ignored by Git.

COMPOSE_PROJECT_NAME=rochekap-remote-dev
TZ=Asia/Shanghai
GIN_MODE=debug
APP_PORT=8080

# The infrastructure ports are published by Docker on this development host.
DEV_REMOTE_HOST=10.3.97.217
DB_DRIVER=postgres
DB_HOST=10.3.97.217
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123!@#
DB_NAME=RocheKAP

# This is a shared development database; schema migration is intentionally
# enabled when the local backend starts.
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=true

# These values must match the server-development environment because model and
# platform configuration stored in PostgreSQL may be encrypted or signed.
JWT_SECRET=rochekap-dev-server-jwt-secret
SYSTEM_AES_KEY=rochekap-dev-system-key-32bytes!

STREAM_MANAGER_TYPE=redis
REDIS_ADDR=10.3.97.217:6379
REDIS_PASSWORD=redis123!@#
REDIS_DB=0
REDIS_PREFIX=rochekap:
# Shared Redis can have materially higher latency than a localhost container.
ROCHE_KAP_REDIS_OP_TIMEOUT_MS=5000

# The current shared server-development environment stores uploaded files on
# its own local Docker volume. Keep local mode here as well; PostgreSQL and
# retrieval middleware still point to the shared server.
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files
MINIO_ENDPOINT=10.3.97.217:9000
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_BUCKET_NAME=

RETRIEVE_DRIVER=milvus
MILVUS_ADDRESS=10.3.97.217:19530
MILVUS_COLLECTION=roche_kap_embeddings
MILVUS_METRIC_TYPE=IP

DOCREADER_ADDR=10.3.97.217:50051
DOCREADER_TRANSPORT=grpc

NEO4J_ENABLE=true
NEO4J_URI=bolt://10.3.97.217:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# The server currently has Langfuse running, but application tracing is off in
# the shared development environment until valid project keys are configured.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://10.3.97.217:3000

# Allow the application to use the internal router/model and infrastructure
# addresses even when enterprise proxy or SSRF checks are enabled.
NO_PROXY=10.3.97.217,127.0.0.1,localhost
no_proxy=10.3.97.217,127.0.0.1,localhost
SSRF_WHITELIST_EXTRA=10.3.97.217

ROCHE_KAP_LANGUAGE=zh-CN
ROCHE_KAP_AGENT_LLM_TIMEOUT=120s
UNIFIED_QA_ROUTE_MODEL_ID=router-grpo
UNIFIED_QA_ROUTE_MODEL_NAME=router-grpo
UNIFIED_QA_ROUTE_MODEL_BASE_URL=http://10.3.97.217:11434/v1
UNIFIED_QA_ROUTE_MODEL_API_KEY=ollama
UNIFIED_QA_ROUTE_MODEL_PROVIDER=generic
UNIFIED_QA_ROUTE_MODEL_OUTPUT_SCHEMA=grpo
UNIFIED_QA_SUMMARY_MODEL_ID=
